{
  "name": "llm-pipeline",
  "version": "3.0.0",
  "description": "Multi-LLM pipeline MCP server - Claude orchestrates OpenAI code generation",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "demo": "tsx scripts/ts/dev/demo-quickstart.ts",
    "pipeline:run": "tsx scripts/ts/dev/pipeline-cli.ts run",
    "check-ipc-sync": "tsx scripts/ts/ci/check-ipc-sync.ts",
    "check-benchmark-pins": "tsx scripts/ts/ci/check-benchmark-pins.ts",
    "verify-lease-audit-bundle": "tsx scripts/ts/ci/verify-lease-audit-bundle.ts",
    "refresh-benchmark-pins": "bash scripts/shell/refresh-benchmark-pins.sh",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:sdk-memory": "node --import tsx --test tests/memory-sdk.integration.test.ts",
    "test:gate2": "node --import tsx --test tests/gate2-control-plane.e2e.test.ts",
    "test:gate3": "node --import tsx --test tests/gate3-orchestrator.e2e.test.ts",
    "test:gates": "node --import tsx --test tests/gate2-control-plane.e2e.test.ts tests/gate3-orchestrator.e2e.test.ts",
    "ci:gates": "tsx scripts/ts/ci/run-ci-gates.ts",
    "ci:gates:smoke": "tsx scripts/ts/ci/run-ci-gates.ts --smoke --allow-skip",
    "test:real-providers": "node --import tsx --test tests/real-provider.integration.test.ts",
    "smoke:real": "node --import tsx scripts/ts/dev/run-real-provider-smoke.ts --mode manual --allow-skip",
    "smoke:real:nightly": "node --import tsx scripts/ts/dev/run-real-provider-smoke.ts --mode nightly",
    "smoke:real:pre-release": "node --import tsx scripts/ts/dev/run-real-provider-smoke.ts --mode pre-release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "openai": "^4.85.0",
    "typescript": "^6.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "comments": {
    "typescript-in-deps": "typescript is in dependencies (not devDependencies) because src/ast_utils.ts imports it at runtime for isSyntaxValid()"
  }
}

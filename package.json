{
  "name": "llm-pipeline",
  "version": "3.0.0",
  "description": "Multi-LLM pipeline MCP server - Claude orchestrates OpenAI code generation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check-ipc-sync": "tsx scripts/check-ipc-sync.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:real-providers": "node --import tsx --test tests/real-provider.integration.test.ts",
    "smoke:real": "node --import tsx scripts/run-real-provider-smoke.ts --mode manual --allow-skip",
    "smoke:real:nightly": "node --import tsx scripts/run-real-provider-smoke.ts --mode nightly",
    "smoke:real:pre-release": "node --import tsx scripts/run-real-provider-smoke.ts --mode pre-release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "openai": "^4.85.0",
    "typescript": "^6.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "comments": {
    "typescript-in-deps": "typescript is in dependencies (not devDependencies) because src/ast_utils.ts imports it at runtime for isSyntaxValid()"
  }
}

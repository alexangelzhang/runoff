{
  "providers": {
    "codex": {
      "type": "cli",
      "command": "codex",
      "args": ["exec", "--full-auto", "--skip-git-repo-check"],
      "mode": "agent-write",
      "timeoutMs": 300000
    },
    "gemini": {
      "type": "cli",
      "command": "gemini",
      "args": [],
      "mode": "agent-write",
      "timeoutMs": 300000
    },
    "claude-code": {
      "type": "cli",
      "command": "claude",
      "args": [],
      "mode": "agent-write",
      "timeoutMs": 300000
    },
    "opencode": {
      "type": "cli",
      "command": "opencode",
      "args": [],
      "mode": "agent-write",
      "timeoutMs": 300000
    },
    "reviewer": {
      "type": "mock"
    }
  },
  "pipeline": {
    "implement": ["codex"],
    "review": ["reviewer", "implement"]
  },
  "retry": {
    "maxRounds": 3,
    "reviewStep": "review"
  },
  "runtime": {
    "raceFinalize": "defer"
  },
  "routing": []
}
